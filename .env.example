# Copiar a .env (ignorado por git) y completar. Nunca subir el .env real.

# --- PostgreSQL (RDS en AWS) ---
DB_URL=jdbc:postgresql://localhost:5432/andesstay_audit
DB_USERNAME=postgres
DB_PASSWORD=cambiar

# --- Kafka ---
# Local: localhost:9092. En EC2/AWS: IP privada del ec2-kafka, ej: 172.31.x.x:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 1 en local, 3 con el cluster de 3 brokers
KAFKA_TOPIC_REPLICAS=1

# --- AWS Cognito (mismo User Pool que catalog, reservations y BFF) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend Angular (CORS) ---
FRONTEND_URL=http://localhost:4200

# --- Servicio ---
SERVER_PORT=8083
